<div class="pagetitle">
	<h1>LOAN MANAGEMENT</h1>
	<nav>
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="openDashboard"> <i class="bi bi-cash-coin"></i>
				</a></li>
			<li class="breadcrumb-item action">IRREGULAR INSTALLMENT PAYMENT</li>
		</ol>
	</nav>
</div>

<div>
	<form id="formid">
		<div>
			<nav>
				<ol class="breadcrumb breadcrumb-title">
					<li class="breadcrumb-item action">SEARCH DETAILS</li>
				</ol>
			</nav>
			<div class="row">
				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="loanId">FIND LOAN ID & NAME</label>
						<select id="loanId" name="loanId" required="required"
							class="form-control selectField" style="height: 30px;">
							<option value="">SELECT LOAN ID</option>
						</select>
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="loanDate">DATE OF LOAN</label>
						<input type="date" name="loanDate" id="loanDate"
							readonly="readonly" placeholder="DATE OF LOAN" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="planName">PLAN NAME</label>
						<input type="text" name="planName" id="planName"
							readonly="readonly" placeholder="ENTER PLAN NAME" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="typeIntrest">INTEREST TYPE</label>
						<input type="text" name="typeIntrest" id="typeIntrest"
							readonly="readonly" placeholder="ENTER INTEREST TYPE" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="fullNume">ID & FULL NAME</label>
						<input type="text" name="fullNume" id="fullNume"
							readonly="readonly" placeholder="ENTER ID & FULL NAME" style="background: #f9f9f9; font-weight: bold; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="duration">DURATION</label>
						<input type="text" name="duration" id="duration"
							readonly="readonly" placeholder="ENTER DURATION" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="paymentEmi">EMI PAYMENT (&#8377;)</label>
						<input type="text" name="paymentEmi" id="paymentEmi"
							readonly="readonly" placeholder="ENTER EMI PAYMENT" style="background: #f9f9f9; font-weight: bold; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="memmberName">FAMILY MEMBER NAME</label>
						<input type="text" name="memmberName" id="memmberName"
							readonly="readonly" placeholder="ENTER FAMILY MEMBER NAME" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="laonCategory">LOAN CATEGORY</label>
						<input type="text" name="laonCategory" id="laonCategory"
							readonly="readonly" placeholder="ENTER LOAN CATEGORY" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="totalIntrestLoan">TOTAL INTEREST OF LOAN</label>
						<input type="text" name="totalIntrestLoan" id="totalIntrestLoan"
							readonly="readonly" placeholder="ENTER TOTAL INTEREST OF LOAN" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="contactNo.">CONTACT NO.</label>
						<input type="text" name="contactNo." id="contactNo."
							readonly="readonly" placeholder="ENTER CONTACT NO." style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="loanAmount2">AMOUNT OF LOAN</label>
						<input type="text" name="loanAmount2" id="loanAmount2"
							readonly="readonly" placeholder="ENTER AMOUNT OF LOAN" style="background: #f9f9f9; font-weight: bold; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="principalLoan2">TOTAL PRINCIPAL OF LOAN</label>
						<input type="text" name="principalLoan2" id="principalLoan2"
							readonly="readonly" placeholder="ENTER TOTAL PRINCIPAL OF LOAN" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="branchAddres">BRANCH ADDRESS</label>
						<input type="text" name="branchAddres" id="branchAddres"
							readonly="readonly" placeholder="ENTER BRANCH ADDRESS" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="rateIntrest">RATE OF INTEREST OF LOAN</label>
						<input type="text" name="rateIntrest" id="rateIntrest"
							readonly="readonly" placeholder="ENTER ROI OF LOAN" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="totalLoanPayable">TOTAL PAYABLE OF LOAN</label>
						<input type="text" name="totalLoanPayable" id="totalLoanPayable"
							readonly="readonly" placeholder="ENTER TOTAL PAYABLE OF LOAN" style="background: #f9f9f9; font-weight: bold; text-transform: uppercase;" />
					</div>
				</div>
			</div>
		</div>

		<div class="mt-5">
			<nav>
				<ol class="breadcrumb breadcrumb-title">
					<li class="breadcrumb-item action">PAYMENT DETAILS</li>
				</ol>
			</nav>
			<div class="row">
				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="dueIntrest2">INTEREST DUE</label>
						<input type="text" name="dueIntrest2" id="dueIntrest2"
							readonly="readonly" placeholder="ENTER INTEREST DUE" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="date1">REGISTRATION DATE</label>
						<input type="date" name="date1" id="date1"
							required="required" placeholder="REGISTRATION DATE" style="text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="duePrinciple2">PRINCIPAL DUE</label>
						<input type="text" name="duePrinciple2" id="duePrinciple2"
							readonly="readonly" placeholder="ENTER PRINCIPAL DUE" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="dueTotalAmount">TOTAL AMOUNT DUE</label>
						<input type="text" name="dueTotalAmount" id="dueTotalAmount"
							readonly="readonly" placeholder="ENTER TOTAL AMOUNT DUE" style="background: #f9f9f9; font-weight: bold; color: #dc3545; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="amountPayment2">PAYMENT AMOUNT (&#8377;) <span style="color:red">*</span></label>
						<input type="number" step="0.01" name="amountPayment2" id="amountPayment2"
							required="required" placeholder="ENTER PAYMENT AMOUNT" style="font-weight: bold; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="duedate2">DUE DATE</label>
						<input type="date" name="duedate2" id="duedate2"
							placeholder="ENTER DUE DATE" style="text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="amountNet">NET AMOUNT (&#8377;)</label>
						<input type="text" name="amountNet" id="amountNet"
							readonly="readonly" placeholder="ENTER NET AMOUNT" style="background: #f9f9f9; font-weight: bold; color: #198754; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="loanId & name">SELECT LOAN ID & NAME</label>
						<select id="loanId & name" name="loanId & name"
							class="form-control selectField" style="height: 30px;">
							<option value="">SELECT LOAN ID</option>
						</select>
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields mb-4">
						<label for="paymentSource">PAYMENT SOURCE <span style="color:red">*</span></label>
						<select id="paymentSource" name="paymentSource"
							required="required" class="form-control selectField" style="height: 30px;">
							<option value="Cash">CASH</option>
							<option value="Saving Account">SAVINGS ACCOUNT</option>
							<option value="Online">ONLINE / UPI</option>
							<option value="Cheque">CHEQUE</option>
							<option value="NEFT">NEFT / RTGS</option>
						</select>
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields">
						<label for="downPayment">DOWN PAYMENT</label>
						<textarea name="downPayment" id="downPayment"
							placeholder="ENTER DOWN PAYMENT DETAILS"
							style="border: 1px solid rgb(224, 224, 224); border-radius: 5px; outline: none; padding: 5px; font-size: 12px; text-transform: uppercase;"></textarea>
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields">
						<label for="advisorId">ADVISOR ID</label>
						<textarea name="advisorId" id="advisorId" readonly="readonly"
							placeholder="ADVISOR ID"
							style="border: 1px solid rgb(224, 224, 224); border-radius: 5px; outline: none; padding: 5px; font-size: 12px; background: #f9f9f9; text-transform: uppercase;"></textarea>
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields">
						<label for="fullnameAdvisor">ADVISOR FULL NAME</label>
						<input type="text" name="fullnameAdvisor" id="fullnameAdvisor"
							readonly="readonly" placeholder="ENTER ADVISOR FULL NAME" style="background: #f9f9f9; text-transform: uppercase;" />
					</div>
				</div>

				<div class="col-lg-3">
					<div class="d-flex flex-column formFields">
						<label for="sectionRemark">REMARKS SECTION</label>
						<input type="text" name="sectionRemark" id="sectionRemark"
							placeholder="ENTER REMARKS SECTION" style="text-transform: uppercase;" />
					</div>
				</div>
			</div>
		</div>

		<div class="row mt-4">
			<div class="col-12 text-center">
				<button type="button" id="saveBtn" class="btnStyle bg-success">SAVE</button>
				<button type="button" id="updateBtn" class="btnStyle" style="background-color: #FFA500;">UPDATE</button>
				<button type="button" id="printBtn" class="btnStyle bg-primary">PRINT</button>
			</div>
		</div>
	</form>

	<div id="receiptArea" style="display: none; margin-top: 25px;"></div>
</div>

<script src="${pageContext.request.contextPath}/js/LoanManagment/irregularInstallmentPayment.js"></script>
